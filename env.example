# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase.
# No Supabase: Project Settings -> API

# URL do projeto (algo como https://abcdefgh.supabase.co)
SUPABASE_URL=

# Chave "service_role" (secreta!). Nunca coloque essa chave em código de front-end.
SUPABASE_SERVICE_ROLE_KEY=

# Qualquer texto longo e aleatório. Serve para assinar o cookie de login.
# Gere um com: openssl rand -base64 32
SESSION_SECRET=
